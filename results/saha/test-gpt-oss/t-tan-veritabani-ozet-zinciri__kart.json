     "SEHIR_OZET": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "Variables": [],
      "HAZIRLA": {
       "Type": "Job:Database:EmbeddedQuery",
       "ConnectionProfile": "PG_UYG",
       "Query": "CREATE TABLE IF NOT EXISTS musteri_sehir_ozet (sehir text PRIMARY KEY, adet int);"
      },
      "HESAPLA": {
       "Type": "Job:Database:SQLScript",
       "ConnectionProfile": "PG_UYG",
       "SQLScript": "/app/sql/sehir_ozet.sql"
      },
      "KONTROL": {
       "Type": "Job:Database:EmbeddedQuery",
       "ConnectionProfile": "PG_UYG",
       "Query": "DO $$ DECLARE cnt int; tot int; BEGIN SELECT COUNT(*) INTO cnt FROM musteri; SELECT SUM(adet) INTO tot FROM musteri_sehir_ozet; IF cnt <> tot THEN RAISE EXCEPTION 'Count mismatch'; END IF; END $$;"
      },
      "BILDIR": {
       "Type": "Job:Command",
       "Command": "echo sehir ozeti tamam $(date +%Y%m%d) >> /var/log/app/sehir_ozet.log",
       "RunAs": "batch"
      },
      "akis": {
       "Type": "Flow",
       "Sequence": [
        "HAZIRLA",
        "HESAPLA",
        "KONTROL",
        "BILDIR"
       ]
      }
     }
    }
