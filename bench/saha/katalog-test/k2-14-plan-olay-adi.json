 "baslik": "plan (os)",
 "talep": "MUHASEBE_KAPANIS akisinin HAZIRLA isi bu sabah calismadi; bekleme durumunda gorunuyor. Hazirlik islemi tamamlandi gorunuyor ama HAZIRLA yine de baslamiyor. Isin sorunsuz calisip dosyanin uretilmesini rica ediyoruz. Sorun tanimdaysa gecici degil kalici cozum isteriz.",
 "kurulum": [
  {
   "sh": {
    "host": "ajan1",
    "cmd": "for spec in batch:2001 etl:2002 finans:2003 mft:2004; do u=${spec%%:*}; n=${spec##*:}; id $u >/dev/null 2>&1 || { addgroup -g $n $u 2>/dev/null; adduser -D -u $n -G $u -s /bin/sh $u 2>/dev/null; }; done; for u in etl finans mft; do addgroup $u batch 2>/dev/null; done; true; sed -i '/StrictHostKeyChecking/d' /etc/ssh/ssh_config 2>/dev/null; true"
   }
  },
  {
   "sh": {
    "host": "ajan2",
    "cmd": "for spec in batch:2001 etl:2002 finans:2003 mft:2004; do u=${spec%%:*}; n=${spec##*:}; id $u >/dev/null 2>&1 || { addgroup -g $n $u 2>/dev/null; adduser -D -u $n -G $u -s /bin/sh $u 2>/dev/null; }; done; for u in etl finans mft; do addgroup $u batch 2>/dev/null; done; true; sed -i '/StrictHostKeyChecking/d' /etc/ssh/ssh_config 2>/dev/null; true"
   }
  },
  {
   "dosya": {
    "host": "ajan1",
    "yol": "/app/scripts/defter_ozet.sh",
    "icerik": "#!/bin/sh\nset -e\n# defter_ozet gunluk ozeti\ngun=${1:-$(date +%Y%m%d)}\nout=/data/giden/defter_ozet_${gun}.txt\necho \"defter_ozet ${gun} satir=$(ls /data/giden | wc -l)\" > \"$out\"\necho \"uretildi: $out\"\n",
    "sahip": "batch:batch",
    "mod": "755"
   }
  },
  {
   "dosya": {
    "host": "ajan2",
    "yol": "/app/scripts/defter_ozet.sh",
    "icerik": "#!/bin/sh\nset -e\n# defter_ozet gunluk ozeti\ngun=${1:-$(date +%Y%m%d)}\nout=/data/giden/defter_ozet_${gun}.txt\necho \"defter_ozet ${gun} satir=$(ls /data/giden | wc -l)\" > \"$out\"\necho \"uretildi: $out\"\n",
    "sahip": "batch:batch",
    "mod": "755"
   }
  },
  {
   "deploy": {
    "MUHASEBE_KAPANIS": {
     "Type": "Folder",
     "Host": "ajan2",
     "RunAs": "batch",
     "HAZIRLA": {
      "Type": "Job:Script",
      "FilePath": "/app/scripts",
      "FileName": "defter_ozet.sh",
      "Arguments": [
       "%%$ODATE"
      ],
      "WaitForEvents": {
       "Type": "WaitForEvents",
       "Events": [
        {
         "Event": "VERI-HAZIRR-DEFTER-OZET"
        }
       ]
      }
     },
     "DOGRULA_DOSYA": {
      "Type": "Job:Command",
      "Command": "test -s /data/giden/defter_ozet_%%$ODATE.txt && echo onay: tamam"
     },
     "akis": {
      "Type": "Flow",
      "Sequence": [
       "HAZIRLA",
       "DOGRULA_DOSYA"
      ]
     }
    },
    "MUHASEBE_KAPANIS_ONCESI": {
     "Type": "Folder",
     "Host": "ajan2",
     "RunAs": "batch",
     "HAZIRLA": {
      "Type": "Job:Command",
      "Command": "echo hazir > /data/tmp/defter_ozet_hazir_%%$ODATE.ok",
      "AddEvents": {
       "Type": "AddEvents",
       "Events": [
        {
         "Event": "VERI-HAZIR-DEFTER-OZET"
        }
       ]
      }
     }
    }
   }
  },
  {
   "order": {
    "folder": "MUHASEBE_KAPANIS_ONCESI",
    "bekle": {
     "HAZIRLA": "Ended OK"
    },
    "sure": 60
   }
  },
  {
   "order": {
    "folder": "MUHASEBE_KAPANIS",
    "bekle": {
     "HAZIRLA": "Wait Condition"
    },
    "sure": 60
   }
  }
 ],
 "kontroller": [
