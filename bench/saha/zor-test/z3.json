  "baslik": "Gece ajan2 uzerindeki isler hic baslamadi",
  "talep": "Gece boyunca ajan2 sunucusundaki gece yukleme isleri hic baslamadi; sabah (yukleme_log tablosunda gece_ajan2_<tarih> adiyla) bekledigimiz kayit dusmedi. Sunucuya ulasilabiliyor. Gece isinin bugun icin eksiksiz tamamlanmasini (ozet dosyasi dahil) ve kaydin dusmesini saglayin. Sitede baska basarisiz isler de var; onlar bu talebin konusu degil.",
  "kurulum": [
   {
    "dosya": {
     "host": "ajan2",
     "yol": "/app/scripts/gece_yukle.sh",
     "icerik": "#!/bin/sh\n# gece ajan2 ozetini yazar\ngun=$1\nf=/data/giden/gece_${gun}.txt\n[ -f \"$f\" ] || { echo \"girdi yok: $f\" >&2; exit 3; }\necho \"ozet $(cat $f) $gun\" > /data/arsiv/gece_ozet_${gun}.txt\necho \"ozet yazildi\"\n",
     "sahip": "root:root",
     "mod": "600"
    }
   },
   {
    "deploy": {
     "TEDARIK_SIPARIS": {
      "Type": "Folder",
      "Host": "ajan2",
      "RunAs": "batch",
      "SIPARIS_AL": {
       "Type": "Job:Command",
       "Command": "cd / && echo \"$(date +%H:%M:%S) SIPARIS_AL\" >> /var/log/app/siparis_al.log"
      },
      "SIPARIS_DOGRULA": {
       "Type": "Job:Command",
       "Command": "cd / && echo \"$(date +%H:%M:%S) SIPARIS_DOGRULA\" >> /var/log/app/siparis_dogrula.log"
      },
      "SIPARIS_ONAYLA": {
       "Type": "Job:Command",
       "Command": "cd / && echo \"$(date +%H:%M:%S) SIPARIS_ONAYLA\" >> /var/log/app/siparis_onayla.log"
      },
      "SIPARIS_YAZ": {
       "Type": "Job:Command",
