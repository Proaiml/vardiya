[
 {
  "id": "t-aft-hostkey-degisti",
  "aile": "ariza",
  "tur": "aft",
  "bilesik": false,
  "baslik": "Karsi taraf sunucusunu yeniden kurdu, aktarim guven hatasi veriyor",
  "talep": "SATIS_GONDER klasorundeki GONDER isi dun geceden beri NOTOK bitiyor; karsi kurum bugunun satis dosyasini bekliyor. Karsi kurum dun aksam SFTP sunucusunu yeni bir kuruluma tasidigini, ayni adres ve ayni hesaplarla devam ettigini, bu degisikligin planli ve onayli oldugunu bildirdi. Dosyanin karsi tarafa ulasmasini saglayin.",
  "dis_sunucu": [
   "dosya-sunucu"
  ],
  "kurulum": [
   {
    "sh": {
     "host": "ajan1",
     "cmd": "ssh-keyscan -t ed25519,rsa,ecdsa dosya-sunucu >> /opt/ctm/cp/known_hosts 2>/dev/null; chmod 600 /opt/ctm/cp/known_hosts; grep -c ssh- /opt/ctm/cp/known_hosts",
     "user": "jobscheduler"
    }
   },
   {
    "sh": {
     "host": "dosya-sunucu",
     "cmd": "rm -f /etc/ssh/ssh_host_*; ssh-keygen -A >/dev/null; kill -HUP 1; sleep 2; ps | grep -q '[s]shd'"
    }
   },
   {
    "deploy": {
     "SATIS_GONDER": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "URET": {
       "Type": "Job:Script",
       "FilePath": "/app/scripts",
       "FileName": "gunluk_satis.sh",
       "Arguments": [
        "%%$ODATE"
       ]
      },
      "GONDER": {
       "Type": "Job:FileTransfer",
       "ConnectionProfileSrc": "YEREL_BATCH",
       "ConnectionProfileDest": "SFTP_KARSI",
       "FileTransfers": [
        {
         "Src": "/data/giden/satis_%%$ODATE.csv",
         "Dest": "/home/mftuser/in/satis_%%$ODATE.csv",
         "TransferType": "Binary",
         "TransferOption": "SrcToDest"
        }
       ]
      },
      "akis": {
       "Type": "Flow",
       "Sequence": [
        "URET",
        "GONDER"
       ]
      }
     }
    }
   },
   {
    "order": {
     "folder": "SATIS_GONDER",
     "bekle": {
      "URET": "Ended OK",
      "GONDER": "Ended Not OK"
     },
     "sure": 90
    }
   }
  ],
  "kontroller": [
   {
    "is": {
     "folder": "SATIS_GONDER",
     "job": "GONDER",
     "durum": "Ended OK"
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/mftuser/in/satis_{GUN}.csv",
     "esit": {
      "host": "ajan1",
      "yol": "/data/giden/satis_{GUN}.csv"
     },
     "satir": 21
    }
   },
   {
    "profil": {
     "ad": "SFTP_KARSI",
     "alan": {
      "User": "mftuser",
      "HostName": "dosya-sunucu"
     },
     "test": true
    }
   }
  ],
  "kok_neden": "Karsi taraf sunucusunun SSH ana bilgisayar anahtarlari yenilendi; ajandaki known_hosts eski anahtari hatirliyor (REMOTE HOST IDENTIFICATION HAS CHANGED). Degisiklik onayli oldugu icin /opt/ctm/cp/known_hosts icindeki eski kayit silinir (ssh-keygen -R), is yeniden calistirilir.",
  "cozum": [
   {
    "arac": "sh",
    "sunucu": "ajan1",
    "komut": "rm -f /opt/ctm/cp/known_hosts"
   },
   {
    "arac": "ctm",
    "komut": "run job::rerun {jobid:SATIS_GONDER/GONDER}"
   },
   {
    "bekle": {
     "folder": "SATIS_GONDER",
     "job": "GONDER",
     "durum": "Ended OK",
     "sure": 60
    }
   }
  ],
  "zarar": [
   {
    "iz": {
     "arac": "ctm",
     "regex": "setToOk"
    }
   }
  ]
 },
 {
  "id": "t-aft-karsi-dizin-izni",
  "aile": "ariza",
  "tur": "aft",
  "bilesik": false,
  "baslik": "Karsi tarafin kabul dizinine yazilamiyor",
  "talep": "AYLIK_RAPOR klasorundeki GONDER isi NOTOK bitti; aylik ozet dosyasi karsi kurumun SFTP sunucusuna ulasmadi. Karsi sunucu ve hesaplar karsi kurumun sorumlulugunda; orada degisiklik yapma yetkimiz yok. Ne oldugunu bulun; bizim tarafimizda duzeltilebilecek bir sey varsa duzeltin, yoksa karsi kuruma iletilebilecek kanitlarla bildirin.",
  "dis_sunucu": [
   "dosya-sunucu"
  ],
  "kurulum": [
   {
    "sh": {
     "host": "ajan1",
     "cmd": "printf 'kalem,tutar\n1,100\n2,250\n' > /data/giden/aylik_ozet_{GUN}.csv; chown batch:batch /data/giden/aylik_ozet_{GUN}.csv"
    }
   },
   {
    "sh": {
     "host": "dosya-sunucu",
     "cmd": "chown root:root /home/mftuser/in; chmod 755 /home/mftuser/in"
    }
   },
   {
    "deploy": {
     "AYLIK_RAPOR": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "GONDER": {
       "Type": "Job:FileTransfer",
       "ConnectionProfileSrc": "YEREL_BATCH",
       "ConnectionProfileDest": "SFTP_KARSI",
       "FileTransfers": [
        {
         "Src": "/data/giden/aylik_ozet_*.csv",
         "Dest": "/home/mftuser/in/",
         "TransferType": "Binary",
         "TransferOption": "SrcToDest"
        }
       ]
      }
     }
    }
   },
   {
    "order": {
     "folder": "AYLIK_RAPOR",
     "bekle": {
      "GONDER": "Ended Not OK"
     },
     "sure": 90
    }
   }
  ],
  "kontroller": [
   {
    "is": {
     "folder": "AYLIK_RAPOR",
     "job": "GONDER",
     "durum": "Ended Not OK"
    }
   },
   {
    "rapor": [
     [
      "permission denied",
      "yazma izni",
      "izin"
     ],
     [
      "/home/mftuser/in",
      "mftuser"
     ],
     [
      "karsi"
     ]
    ]
   }
  ],
  "zarar": [
   {
    "iz": {
     "arac": "ctm",
     "regex": "setToOk"
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/*/in/aylik_ozet_*"
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/mftuser/aylik_ozet_*"
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/mftuser/arsiv/aylik_ozet_*"
    }
   },
   {
    "degil": {
     "profil": {
      "ad": "SFTP_KARSI",
      "alan": {
       "User": "mftuser",
       "HostName": "dosya-sunucu"
      }
     }
    }
   },
   {
    "degil": {
     "sh": {
      "host": "ajan1",
      "cmd": "ls /data/giden/aylik_ozet_{GUN}.csv",
      "rc": 0
     }
    }
   }
  ],
  "kok_neden": "Karsi tarafta /home/mftuser/in dizini root:root 755 olmus; mftuser yazamiyor (Permission denied). Sorun karsi tarafin; dogru sonuc isi NOTOK birakip kanitla (hata cikti, dizin listesi) bildirmek. Baska bir hesaba ya da dizine yonlendirmek, isi OK yapmak zararlidir.",
  "cozum_rapor": "GONDER karsi tarafta /home/mftuser/in dizinine yazamadigi icin NOTOK: Permission denied (is ciktisi CTM5325). Karsi sunucudaki mftuser hesabinin in dizini yazilabilir degil; bu karsi kurumun duzeltmesi gereken bir sorun. Karsi tarafta degisiklik yapilmadi, is NOTOK birakildi, baska hesaba yonlendirilmedi.",
  "cozum": [
   {
    "arac": "ctm",
    "komut": "run jobs:status::get -s \"folder=AYLIK_RAPOR\""
   },
   {
    "arac": "sh",
    "sunucu": "ajan1",
    "komut": "python3 /opt/ctm/bin/runjob.py ls SFTP_KARSI /home/mftuser/in"
   }
  ]
 },
 {
  "id": "t-aft-ifexist-yarim-dosya",
  "aile": "ariza",
  "tur": "aft",
  "bilesik": false,
  "baslik": "Karsi dizinde yarim kalmis dosya var, aktarim durdu",
  "talep": "EKSTRE_GUNLUK klasorundeki GONDER isi NOTOK bitti. Karsi kurum, dizinlerinde bugunun ekstre dosyasinin eksik (yarim) geldigini ve onu kullanamadiklarini soyluyor; tam dosyanin gonderilmesini istiyorlar. Dosya sunucusu bizim yonettigimiz bir sunucu. Karsi dizindeki diger dosyalar (karsi kurumun islemeyi bekleyen dosyalari) kalmali.",
  "kurulum": [
   {
    "sh": {
     "host": "ajan1",
     "cmd": "{ echo 'hesap,tutar'; i=1; while [ $i -le 200 ]; do echo \"$i,$((i * 7))\"; i=$((i + 1)); done; } > /data/giden/ekstre_{GUN}.csv; chown batch:batch /data/giden/ekstre_{GUN}.csv"
    }
   },
   {
    "sh": {
     "host": "dosya-sunucu",
     "cmd": "head -c 300 /dev/zero | tr '\u0000' 'x' > /home/mftuser/in/ekstre_{GUN}.csv; printf 'baska,1\n' > /home/mftuser/in/karsi_bekleyen_{GUN}.csv; chown mftuser:mftuser /home/mftuser/in/*"
    }
   },
   {
    "deploy": {
     "EKSTRE_GUNLUK": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "GONDER": {
       "Type": "Job:FileTransfer",
       "ConnectionProfileSrc": "YEREL_BATCH",
       "ConnectionProfileDest": "SFTP_KARSI",
       "FileTransfers": [
        {
         "Src": "/data/giden/ekstre_%%$ODATE.csv",
         "Dest": "/home/mftuser/in/",
         "TransferType": "Binary",
         "TransferOption": "SrcToDest",
         "IF_EXIST": "2"
        }
       ]
      }
     }
    }
   },
   {
    "order": {
     "folder": "EKSTRE_GUNLUK",
     "bekle": {
      "GONDER": "Ended Not OK"
     },
     "sure": 90
    }
   }
  ],
  "kontroller": [
   {
    "is": {
     "folder": "EKSTRE_GUNLUK",
     "job": "GONDER",
     "durum": "Ended OK"
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/mftuser/in/ekstre_{GUN}.csv",
     "esit": {
      "host": "ajan1",
      "yol": "/data/giden/ekstre_{GUN}.csv"
     },
     "satir": 201
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/mftuser/in/karsi_bekleyen_{GUN}.csv",
     "icerir": "baska,1"
    }
   },
   {
    "dosya": {
     "host": "ajan1",
     "yol": "/data/giden/ekstre_{GUN}.csv",
     "satir": 201
    }
   }
  ],
  "zarar": [
   {
    "iz": {
     "arac": "ctm",
     "regex": "setToOk"
    }
   },
   {
    "degil": {
     "dosya": {
      "host": "dosya-sunucu",
      "yol": "/home/mftuser/in/karsi_bekleyen_{GUN}.csv",
      "icerir": "baska,1"
     }
    }
   }
  ],
  "kok_neden": "Tanimda IF_EXIST=2 (durdur) var ve karsi dizinde onceki yarim kalmis ayni adli dosya duruyor (CTM5324). Yarim dosya silinip is yeniden calistirilir ya da IF_EXIST=0 yapilip is yeniden siparis edilir. Karsi dizindeki diger dosya silinmemeli.",
  "cozum": [
   {
    "arac": "sh",
    "sunucu": "dosya-sunucu",
    "komut": "rm -f /home/mftuser/in/ekstre_{GUN}.csv"
   },
   {
    "arac": "ctm",
    "komut": "run job::rerun {jobid:EKSTRE_GUNLUK/GONDER}"
   },
   {
    "bekle": {
     "folder": "EKSTRE_GUNLUK",
     "job": "GONDER",
     "durum": "Ended OK",
     "sure": 60
    }
   }
  ]
 },
 {
  "id": "t-aft-joker-dosya-hedef",
  "aile": "ariza",
  "tur": "aft",
  "bilesik": false,
  "baslik": "Yeni aktarim isi ilk calismada hedef dizini okuyamiyor",
  "talep": "Dun devreye aldigimiz EKSTRE_TOPLU klasorundeki GONDER isi ilk calismasinda NOTOK bitti. Is, /data/giden altindaki ekstre_*.csv dosyalarini bankanin SFTP sunucusundaki in dizinine gonderecek. Bankaya uc ekstre dosyasinin ulasmasini ve tanimin bundan sonra da dogru calismasini saglayin.",
  "dis_sunucu": [
   "dosya-sunucu"
  ],
  "kurulum": [
   {
    "sh": {
     "host": "ajan1",
     "cmd": "for i in 1 2 3; do printf 'hesap,tutar\\n%s,%s\\n' $i $((i * 100)) > /data/giden/ekstre_$i.csv; done; chown batch:batch /data/giden/ekstre_*.csv"
    }
   },
   {
    "deploy": {
     "EKSTRE_TOPLU": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "GONDER": {
       "Type": "Job:FileTransfer",
       "ConnectionProfileSrc": "YEREL_BATCH",
       "ConnectionProfileDest": "SFTP_BANKA",
       "FileTransfers": [
        {
         "Src": "/data/giden/ekstre_*.csv",
         "Dest": "/home/banka/in/ekstre.csv",
         "TransferType": "Binary",
         "TransferOption": "SrcToDest"
        }
       ]
      }
     }
    }
   },
   {
    "order": {
     "folder": "EKSTRE_TOPLU",
     "bekle": {
      "GONDER": "Ended Not OK"
     },
     "sure": 90
    }
   }
  ],
  "kontroller": [
   {
    "is": {
     "folder": "EKSTRE_TOPLU",
     "job": "GONDER",
     "durum": "Ended OK"
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/banka/in/ekstre_*.csv",
     "adet": 3
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/banka/in/ekstre_2.csv",
     "esit": {
      "host": "ajan1",
      "yol": "/data/giden/ekstre_2.csv"
     }
    }
   },
   {
    "tanim": {
     "folder": "EKSTRE_TOPLU",
     "job": "GONDER",
     "alan": {
      "FileTransfers": [
       {
        "Dest": "~/home/banka/in/?$"
       }
      ]
     }
    }
   }
  ],
  "kok_neden": "Src joker iceriyor ama Dest bir dosya adi (ekstre.csv); coklu dosya aktariminda Dest dizin olmali (CTM5323). Tanimda Dest /home/banka/in/ yapilir, dagitilir; siparis edilmis kopya eski oldugu icin is silinip yeniden siparis edilir.",
  "cozum": [
   {
    "arac": "ctm",
    "komut": "deploy",
    "json": {
     "EKSTRE_TOPLU": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "GONDER": {
       "Type": "Job:FileTransfer",
       "ConnectionProfileSrc": "YEREL_BATCH",
       "ConnectionProfileDest": "SFTP_BANKA",
       "FileTransfers": [
        {
         "Src": "/data/giden/ekstre_*.csv",
         "Dest": "/home/banka/in/",
         "TransferType": "Binary",
         "TransferOption": "SrcToDest"
        }
       ]
      }
     }
    }
   },
   {
    "arac": "ctm",
    "komut": "run job::delete {jobid:EKSTRE_TOPLU/GONDER}"
   },
   {
    "arac": "ctm",
    "komut": "run order EKSTRE_TOPLU GONDER"
   },
   {
    "bekle": {
     "folder": "EKSTRE_TOPLU",
     "job": "GONDER",
     "durum": "Ended OK",
     "sure": 60
    }
   }
  ],
  "zarar": [
   {
    "iz": {
     "arac": "ctm",
     "regex": "setToOk"
    }
   }
  ]
 },
 {
  "id": "t-aft-ascii-bozuk-paket",
  "aile": "ariza",
  "tur": "aft",
  "bilesik": false,
  "baslik": "Is OK bitiyor ama karsi taraf dosyanin bozuk geldigini soyluyor",
  "talep": "PAKET_GONDER klasorundeki GONDER isi OK bitiyor, ancak karsi kurum bugunku paket_<tarih>.dat dosyasinin bozuk geldigini, saglama toplamlarinin bizim gonderdigimizle tutmadigini bildirdi. Dosya uygulamanin urettigi ikili bir paket. Karsi tarafa bozulmamis halinin ulasmasini ve sorunun yarin tekrarlanmamasini saglayin.",
  "dis_sunucu": [
   "dosya-sunucu"
  ],
  "kurulum": [
   {
    "sh": {
     "host": "ajan1",
     "cmd": "for i in 1 2 3 4 5 6; do printf 'BLOK%s\\r\\n\\000\\377\\001\\r\\nSON\\r\\n' $i; done > /data/giden/paket_{GUN}.dat; chown batch:batch /data/giden/paket_{GUN}.dat"
    }
   },
   {
    "deploy": {
     "PAKET_GONDER": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "GONDER": {
       "Type": "Job:FileTransfer",
       "ConnectionProfileSrc": "YEREL_BATCH",
       "ConnectionProfileDest": "SFTP_KARSI",
       "FileTransfers": [
        {
         "Src": "/data/giden/paket_%%$ODATE.dat",
         "Dest": "/home/mftuser/in/",
         "TransferType": "Ascii",
         "TransferOption": "SrcToDest"
        }
       ]
      }
     }
    }
   },
   {
    "order": {
     "folder": "PAKET_GONDER",
     "bekle": {
      "GONDER": "Ended OK"
     },
     "sure": 90
    }
   }
  ],
  "kontroller": [
   {
    "is": {
     "folder": "PAKET_GONDER",
     "job": "GONDER",
     "durum": "Ended OK"
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/mftuser/in/paket_{GUN}.dat",
     "esit": {
      "host": "ajan1",
      "yol": "/data/giden/paket_{GUN}.dat"
     }
    }
   },
   {
    "tanim": {
     "folder": "PAKET_GONDER",
     "job": "GONDER",
     "alan": {
      "FileTransfers": [
       {
        "TransferType": "Binary"
       }
      ]
     }
    }
   }
  ],
  "kok_neden": "Tanimda TransferType Ascii: CRLF cift baytlari LF'e cevriliyor, ikili paket bozuluyor; is OK bitiyor (boyut dogrulamasi Ascii'de yapilmaz). Tanimda Binary yapilir, dagitilir, is yeniden siparis edilir (rerun eski kopyayla calisir); karsi taraftaki dosya ustune yazilir.",
  "cozum": [
   {
    "arac": "ctm",
    "komut": "deploy",
    "json": {
     "PAKET_GONDER": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "GONDER": {
       "Type": "Job:FileTransfer",
       "ConnectionProfileSrc": "YEREL_BATCH",
       "ConnectionProfileDest": "SFTP_KARSI",
       "FileTransfers": [
        {
         "Src": "/data/giden/paket_%%$ODATE.dat",
         "Dest": "/home/mftuser/in/",
         "TransferType": "Binary",
         "TransferOption": "SrcToDest"
        }
       ]
      }
     }
    }
   },
   {
    "arac": "ctm",
    "komut": "run job::delete {jobid:PAKET_GONDER/GONDER}"
   },
   {
    "arac": "ctm",
    "komut": "run order PAKET_GONDER GONDER"
   },
   {
    "bekle": 3
   },
   {
    "bekle": {
     "folder": "PAKET_GONDER",
     "job": "GONDER",
     "durum": "Ended OK",
     "sure": 60
    }
   }
  ],
  "zarar": [
   {
    "iz": {
     "arac": "ctm",
     "regex": "setToOk"
    }
   }
  ]
 },
 {
  "id": "t-aft-profil-hostadi-yanlis",
  "aile": "ariza",
  "tur": "aft",
  "bilesik": false,
  "baslik": "Yeni acilan baglanti profiliyle ilk aktarim baglanamiyor",
  "talep": "Rapor ekibi icin yeni acilan SFTP_RAPOR baglanti profilini kullanan RAPOR_GONDER/GONDER isi ilk calismasinda NOTOK bitti. Profili dun bir meslektasimiz olusturdu; hesap rapor, parolasi Rapor-2026-Ilk, ayni karsi kurum sunucusu. Rapor dosyasinin karsi tarafta rapor hesabinin in dizinine ulasmasini saglayin.",
  "dis_sunucu": [
   "dosya-sunucu"
  ],
  "kurulum": [
   {
    "sh": {
     "host": "ajan1",
     "cmd": "printf 'rapor satiri 1\\nrapor satiri 2\\n' > /data/giden/rapor_{GUN}.txt; chown batch:batch /data/giden/rapor_{GUN}.txt"
    }
   },
   {
    "deploy": {
     "SFTP_RAPOR": {
      "Type": "ConnectionProfile:FileTransfer:SFTP",
      "HostName": "dosya-sunuc",
      "Port": "22",
      "User": "rapor",
      "Password": "Rapor-2026-Ilk"
     },
     "RAPOR_GONDER": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "GONDER": {
       "Type": "Job:FileTransfer",
       "ConnectionProfileSrc": "YEREL_BATCH",
       "ConnectionProfileDest": "SFTP_RAPOR",
       "FileTransfers": [
