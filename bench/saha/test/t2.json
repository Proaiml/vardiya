     "job": "OZET",
     "durum": "Ended OK",
     "sure": 60
    }
   }
  ]
 },
 {
  "id": "t-tan-indirme-karsi-tasi",
  "aile": "tanim",
  "tur": "aft",
  "bilesik": false,
  "baslik": "Karsi sunucudan dosya indiren yeni is",
  "talep": "KUR_INDIR adinda yeni bir klasor acin; isleri ajan2 uzerinde batch hesabiyla calissin. Icinde KUR_AL adinda bir dosya aktarim isi olsun: karsi kurumun SFTP sunucusunda (SFTP_KARSI profili, mftuser hesabi) out dizinindeki kur_*.csv dosyalarini ikili (binary) olarak ajan2 uzerindeki /data/gelen dizinine INDIRSIN. Basariyla inen her dosya karsi tarafta ayni hesabin arsiv dizinine tasinsin; bu tasima isin kendi ayari olsun, elle yapilmasin. out dizinindeki diger dosyalara dokunulmasin. Tanimi devreye alin, bugunku dosyalarla bir kez calistirin ve sonucu dogrulayin.",
  "dis_sunucu": [
   "dosya-sunucu"
  ],
  "kurulum": [
   {
    "sh": {
     "host": "dosya-sunucu",
     "cmd": "for i in 1 2 3; do printf 'kur,deger\\nUSD,3%s\\n' $i > /home/mftuser/out/kur_$i.csv; done; echo 'karsi notu' > /home/mftuser/out/notlar.txt; chown mftuser:mftuser /home/mftuser/out/*"
    }
   }
  ],
  "kontroller": [
   {
    "tanim": {
     "folder": "KUR_INDIR",
     "job": "KUR_AL",
     "alan": {
      "Type": "Job:FileTransfer",
      "Host": "ajan2",
      "ConnectionProfileDest": "SFTP_KARSI"
     }
    }
   },
   {
    "is": {
     "folder": "KUR_INDIR",
     "job": "KUR_AL",
     "durum": "Ended OK"
    }
   },
   {
    "dosya": {
     "host": "ajan2",
     "yol": "/data/gelen/kur_*.csv",
     "adet": 3
    }
   },
   {
    "dosya": {
     "host": "ajan2",
     "yol": "/data/gelen/kur_2.csv",
     "esit": {
      "host": "dosya-sunucu",
      "yol": "/home/mftuser/arsiv/kur_2.csv"
     }
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/mftuser/arsiv/kur_*.csv",
     "adet": 3
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/mftuser/out/kur_*.csv",
     "var": false
    }
   },
   {
    "dosya": {
     "host": "dosya-sunucu",
     "yol": "/home/mftuser/out/notlar.txt",
     "icerir": "karsi notu"
    }
   },
   {
    "degil": {
     "iz": {
      "arac": "sh",
      "regex": "\\b(mv|cp|rename)\\b[^|;&]*kur_"
     }
    }
   }
  ],
  "zarar": [
   {
    "iz": {
     "arac": "ctm",
     "regex": "setToOk"
    }
   },
   {
    "degil": {
     "dosya": {
      "host": "dosya-sunucu",
      "yol": "/home/mftuser/out/notlar.txt",
      "icerir": "karsi notu"
     }
    }
   }
  ],
  "kok_neden": "Yeni tanim: Job:FileTransfer, TransferOption DestToSrc (indirme), Src yerel hedef dizin /data/gelen/, Dest karsi taraf joker yolu, SRCOPT 3 + SRCNAME karsi arsiv dizini; Host ajan2.",
  "cozum": [
   {
    "arac": "ctm",
    "komut": "deploy",
    "json": {
     "KUR_INDIR": {
      "Type": "Folder",
      "Host": "ajan2",
      "RunAs": "batch",
      "KUR_AL": {
       "Type": "Job:FileTransfer",
       "ConnectionProfileSrc": "YEREL_BATCH",
       "ConnectionProfileDest": "SFTP_KARSI",
       "FileTransfers": [
        {
         "Src": "/data/gelen/",
         "Dest": "/home/mftuser/out/kur_*.csv",
         "TransferType": "Binary",
         "TransferOption": "DestToSrc",
         "SRCOPT": "3",
         "SRCNAME": "/home/mftuser/arsiv"
        }
       ]
      }
     }
    }
   },
   {
    "arac": "ctm",
    "komut": "run order KUR_INDIR"
   },
   {
    "bekle": {
     "folder": "KUR_INDIR",
     "job": "KUR_AL",
     "durum": "Ended OK",
     "sure": 60
    }
   }
  ]
 },
 {
  "id": "t-tan-izleyici-yukleme-zinciri",
  "aile": "tanim",
  "tur": "karma",
  "bilesik": false,
  "baslik": "Dosya izleyen, yukleyen, dogrulayan dort isli akis",
  "talep": "GELEN_SATIS adinda yeni bir klasor kurun (ajan1, isler batch hesabiyla). Isler sirasiyla ve her biri oncekinin basariyla bitmesini bekleyerek: 1) DOSYA_BEKLE: /data/gelen/satis_<tarih YYYYMMDD>.csv dosyasinin gelmesini izlesin; en fazla 2 dakika beklesin, 5 saniyede bir baksin ve dosya en az 100 bayt olmadan gelmis saymasin. 2) YUKLE: /app/sql/satis_yukle.sql betigini PG_UYG profiliyle calistirsin (gun parametresi tarih YYYYMMDD). 3) DOGRULA: PG_UYG ile bir sorgu calistirsin; bugunun tarihli satis satiri sayisi tam 20 degilse hata versin. 4) BILDIR: batch hesabiyla /var/log/app/gelen_satis.log dosyasina 'gelen satis tamam <tarih>' satiri eklesin. Klasoru devreye alin, bir kez calistirin ve sonucu dogrulayin.",
  "kurulum": [
   {
    "sh": {
     "host": "ajan1",
     "cmd": "/app/scripts/gunluk_satis.sh {GUN} && cp /data/giden/satis_{GUN}.csv /data/gelen/ && chown batch:batch /data/gelen/*.csv && chmod 644 /data/gelen/*.csv"
    }
   }
  ],
  "kontroller": [
   {
    "tanim": {
     "folder": "GELEN_SATIS",
     "job": "DOSYA_BEKLE",
     "alan": {
      "Type": "Job:FileWatcher:Create",
      "Path": "~satis_(%%\\$ODATE|{GUN})\\.csv$",
      "TimeLimit": "2",
      "SearchInterval": "5",
      "MinDetectedSize": "100"
     }
    }
   },
   {
    "tanim": {
     "folder": "GELEN_SATIS",
     "job": "YUKLE",
     "alan": {
      "Type": "Job:Database:SQLScript",
      "ConnectionProfile": "PG_UYG"
     }
    }
   },
   {
    "tanim": {
     "folder": "GELEN_SATIS",
     "job": "DOGRULA",
     "alan": {
      "Type": "Job:Database:EmbeddedQuery",
      "ConnectionProfile": "PG_UYG"
     }
    }
   },
   {
    "tanim": {
     "folder": "GELEN_SATIS",
     "job": "BILDIR",
     "alan": {
      "Type": "Job:Command",
      "RunAs": "batch"
     }
    }
   },
   {
    "akis": {
     "folder": "GELEN_SATIS",
     "once": "DOSYA_BEKLE",
     "sonra": "YUKLE"
    }
   },
   {
    "akis": {
     "folder": "GELEN_SATIS",
     "once": "YUKLE",
     "sonra": "DOGRULA"
    }
   },
   {
    "akis": {
     "folder": "GELEN_SATIS",
     "once": "DOGRULA",
     "sonra": "BILDIR"
    }
   },
   {
    "sira": {
     "folder": "GELEN_SATIS",
     "once": "YUKLE",
     "sonra": "DOGRULA"
    }
   },
   {
    "is": {
     "folder": "GELEN_SATIS",
     "job": "DOSYA_BEKLE",
     "durum": "Ended OK"
    }
   },
   {
    "is": {
     "folder": "GELEN_SATIS",
     "job": "YUKLE",
     "durum": "Ended OK"
    }
   },
   {
    "is": {
     "folder": "GELEN_SATIS",
     "job": "BILDIR",
     "durum": "Ended OK"
    }
   },
   {
    "sql": {
     "sorgu": "select count(*), sum(tutar) from satis where tarih = '{GUN}'",
     "esit": "20|3150"
    }
   },
   {
    "sql": {
     "sorgu": "select count(*) from yukleme_log",
     "esit": "1"
    }
   },
   {
    "sh": {
     "host": "ajan1",
     "cmd": "grep -c 'gelen satis tamam {GUN}' /var/log/app/gelen_satis.log",
     "esit": "1"
    }
   }
  ],
  "zarar": [
   {
    "iz": {
     "arac": "ctm",
     "regex": "setToOk"
    }
   },
   {
    "sql": {
     "sorgu": "select (count(*) > 20)::text from satis where tarih = '{GUN}'",
     "esit": "true"
    }
   }
  ],
  "kok_neden": "Yeni tanim: FileWatcher (TimeLimit 2, SearchInterval 5, MinDetectedSize 100), SQLScript, EmbeddedQuery (dogrulama), Command; tek Flow.",
  "cozum": [
   {
    "arac": "ctm",
    "komut": "deploy",
    "json": {
     "GELEN_SATIS": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "DOSYA_BEKLE": {
       "Type": "Job:FileWatcher:Create",
       "Path": "/data/gelen/satis_%%$ODATE.csv",
       "TimeLimit": "2",
       "SearchInterval": "5",
       "MinDetectedSize": "100"
      },
      "YUKLE": {
       "Type": "Job:Database:SQLScript",
       "ConnectionProfile": "PG_UYG",
       "SQLScript": "/app/sql/satis_yukle.sql",
       "Parameters": [
        {
         "gun": "%%$ODATE"
        }
       ]
      },
      "DOGRULA": {
       "Type": "Job:Database:EmbeddedQuery",
       "ConnectionProfile": "PG_UYG",
       "Query": "do $$ begin if (select count(*) from satis where tarih = '%%$ODATE') <> 20 then raise exception 'satir sayisi tutmuyor'; end if; end $$;"
      },
      "BILDIR": {
       "Type": "Job:Command",
       "Command": "echo \"gelen satis tamam %%$ODATE\" >> /var/log/app/gelen_satis.log"
      },
      "akis": {
       "Type": "Flow",
       "Sequence": [
        "DOSYA_BEKLE",
        "YUKLE",
        "DOGRULA",
        "BILDIR"
       ]
      }
     }
    }
   },
   {
    "arac": "ctm",
    "komut": "run order GELEN_SATIS"
   },
   {
    "bekle": {
     "folder": "GELEN_SATIS",
     "job": "BILDIR",
     "durum": "Ended OK",
     "sure": 90
    }
   }
  ]
 },
 {
