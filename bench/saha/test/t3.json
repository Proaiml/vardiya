    "dosya": {
     "host": "ajan1",
     "yol": "/data/giden/ozet_hesapla_{GUN}.txt"
    }
   }
  ],
  "kok_neden": "Betik ajan2'de yok ve betigin yanindaki ozet.conf dosyasini da kaynak aliyor; ikisi de ajan2'ye (ayni yola) kopyalanmali. Tanimda Host ajan2 yapilip dagitilir, ajan1'deki ornek silinir, is yeniden siparis edilir. ajan1'deki dosyalar silinmemeli.",
  "cozum": [
   {
    "arac": "sh",
    "sunucu": "ajan2",
    "komut": "cat > /app/scripts/ozet_hesapla.sh <<'EOS'\n#!/bin/sh\n. /app/scripts/ozet.conf\necho \"ozet $ETIKET $(date +%Y%m%d) sunucu=$(hostname)\" > /data/giden/ozet_hesapla_$(date +%Y%m%d).txt\necho tamam\nEOS\nprintf 'ETIKET=aylik\\n' > /app/scripts/ozet.conf; chown batch:batch /app/scripts/ozet_hesapla.sh /app/scripts/ozet.conf; chmod 755 /app/scripts/ozet_hesapla.sh; chmod 644 /app/scripts/ozet.conf"
   },
   {
