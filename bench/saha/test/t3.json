    "profil": {
     "ad": "PG_UYG",
     "alan": {
      "User": "etl_user",
      "Password": "Etl-2026-Q4"
     },
     "test": true
    }
   },
   {
    "is": {
     "folder": "SIFRE_TESTI",
     "job": "SFTP_TEST",
     "durum": "Ended OK"
    }
   },
   {
    "is": {
     "folder": "SIFRE_TESTI",
     "job": "DB_TEST",
     "durum": "Ended OK"
    }
