       "Command": "cd / && find /data/dar -name 'eski_yedek_*.tgz' -mtime +7 -exec rm -f {} \\;"
      },
      "YEDEK_AL": {
       "Type": "Job:Command",
       "Command": "tar czf /data/dar/yedek_%%$ODATE.tgz -C /data giden && echo yedek tamam"
      },
      "DOGRULA": {
       "Type": "Job:Command",
       "Command": "tar tzf /data/dar/yedek_%%$ODATE.tgz > /dev/null && echo dogrulandi"
      },
      "akis": {
       "Type": "Flow",
       "Sequence": [
        "TEMIZLE",
        "YEDEK_AL",
        "DOGRULA"
       ]
      }
     }
    }
   },
