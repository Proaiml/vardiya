      "Type": "Folder",
      "Host": "ajan2",
      "RunAs": "batch",
      "OZET": {
       "Type": "Job:Script",
       "FilePath": "/app/scripts",
       "FileName": "ozet_hesapla.sh"
      }
     }
    }
   },
   {
    "arac": "ctm",
    "komut": "run order RAPORLAMA"
