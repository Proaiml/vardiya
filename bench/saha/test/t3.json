    }
   }
  ]
 },
 {
  "id": "t-tan-sakli-yordam-gun-kapat",
  "aile": "tanim",
  "tur": "db",
  "bilesik": false,
  "baslik": "Sakli yordam cagiran gun kapatma isi",
  "talep": "GUN_KAPAT adinda yeni bir klasor kurun (ajan1, batch). 1) KAPAT: veritabanindaki public.gun_kapat sakli yordamini PG_UYG profiliyle cagirsin; yordamin tek parametresi var: gunun tarihi (YYYYMMDD, metin). Is basarisiz olursa 1 dakika arayla en cok 2 kez kendiliginden yeniden denensin. 2) DOGRULA: KAPAT basariyla bittikten sonra PG_UYG ile bir sorgu calistirsin; yukleme_log tablosunda 'gun_kapat_<tarih>' adli tam bir kayit yoksa hata versin. Klasoru devreye alin, bir kez calistirin ve sonucu dogrulayin; yordami degistirmeyin.",
  "kurulum": [
   {
    "sql": "create or replace procedure public.gun_kapat(p_gun text) language plpgsql as $$ begin insert into yukleme_log (dosya, satir) values ('gun_kapat_' || p_gun, 0); end $$; alter procedure public.gun_kapat(text) owner to etl_user;"
   }
  ],
  "kontroller": [
   {
    "tanim": {
     "folder": "GUN_KAPAT",
     "job": "KAPAT",
     "alan": {
      "Type": "Job:Database:StoredProcedure",
      "ConnectionProfile": "PG_UYG",
      "StoredProcedure": "gun_kapat",
      "Rerun": {
       "Times": "2"
      }
     }
    }
   },
   {
    "tanim": {
     "folder": "GUN_KAPAT",
     "job": "DOGRULA",
     "alan": {
      "Type": "Job:Database:EmbeddedQuery"
     }
    }
   },
   {
    "akis": {
     "folder": "GUN_KAPAT",
     "once": "KAPAT",
     "sonra": "DOGRULA"
    }
   },
   {
    "is": {
     "folder": "GUN_KAPAT",
     "job": "KAPAT",
     "durum": "Ended OK"
    }
   },
   {
    "is": {
     "folder": "GUN_KAPAT",
     "job": "DOGRULA",
     "durum": "Ended OK"
    }
   },
   {
    "sql": {
     "sorgu": "select count(*) from yukleme_log where dosya = 'gun_kapat_{GUN}'",
     "esit": "1"
    }
   }
  ],
  "zarar": [
   {
    "iz": {
     "arac": "ctm",
     "regex": "setToOk"
    }
   },
   {
    "degil": {
     "sql": {
      "sorgu": "select count(*) from pg_proc where proname = 'gun_kapat'",
      "esit": "1"
     }
    }
   }
  ],
  "kok_neden": "Yeni tanim: Job:Database:StoredProcedure (StoredProcedure gun_kapat, Parameters tek deger, Rerun Times 2) ve EmbeddedQuery dogrulama; tek Flow.",
  "cozum": [
   {
    "arac": "ctm",
    "komut": "deploy",
    "json": {
     "GUN_KAPAT": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "KAPAT": {
       "Type": "Job:Database:StoredProcedure",
       "ConnectionProfile": "PG_UYG",
       "StoredProcedure": "gun_kapat",
       "Schema": "public",
       "Parameters": [
        {
         "p_gun": "%%$ODATE"
        }
       ],
       "Rerun": {
        "Times": "2",
        "Interval": "1",
        "Units": "Minutes"
       }
      },
      "DOGRULA": {
       "Type": "Job:Database:EmbeddedQuery",
       "ConnectionProfile": "PG_UYG",
       "Query": "do $$ begin if (select count(*) from yukleme_log where dosya = 'gun_kapat_%%$ODATE') <> 1 then raise exception 'kayit yok'; end if; end $$;"
      },
      "akis": {
       "Type": "Flow",
       "Sequence": [
        "KAPAT",
        "DOGRULA"
       ]
      }
     }
    }
   },
   {
    "arac": "ctm",
    "komut": "run order GUN_KAPAT"
   },
   {
    "bekle": {
     "folder": "GUN_KAPAT",
     "job": "DOGRULA",
     "durum": "Ended OK",
     "sure": 90
    }
   }
  ]
 },
 {
  "id": "t-b-yon-parola-donusu-iki-sistem",
  "aile": "yonetim",
  "tur": "karma",
  "bilesik": true,
  "baslik": "Ceyreklik parola donusu: karsi taraf SFTP hesabi ve veritabani hesabi",
  "talep": "Guvenlik politikasi geregi bu ceyrek iki hesabin parolasi donuyor. 1) Karsi taraf SFTP sunucusunda (bizim yonettigimiz sunucu) mftuser hesabinin yeni parolasi Mft-2026-Q4. 2) Veritabaninda etl_user hesabinin yeni parolasi Etl-2026-Q4. Hesap parolalarini ve ilgili baglanti profillerini (SFTP_KARSI, PG_UYG) guncelleyin; eski parolalar artik gecerli olmasin. SIFRE_TESTI klasorundeki iki isi calistirip iki baglantinin da calistigini dogrulayin. Diger hesaplara (banka, rapor, rapor_user) dokunmayin.",
  "kurulum": [
   {
    "sh": {
     "host": "ajan1",
     "cmd": "printf 'sifre testi\\n' > /data/giden/sifre_testi.txt; chown batch:batch /data/giden/sifre_testi.txt"
    }
   },
