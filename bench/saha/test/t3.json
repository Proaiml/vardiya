 {
  "id": "t-yon-is-tasima-ajan2-betik-yaninda",
  "aile": "yonetim",
  "tur": "os",
  "bilesik": false,
  "baslik": "Bir isin kalici olarak ajan2 sunucusuna tasinmasi",
  "talep": "ajan1 sunucusu gelecek hafta kalici olarak kapatilacak. RAPORLAMA klasorundeki OZET isi ajan1 uzerinde tanimli ve /app/scripts/ozet_hesapla.sh betigini calistiriyor. Isi kalici olarak ajan2 sunucusuna tasiyin ve bugun ajan2 uzerinde bir kez calistirip ozet dosyasinin ajan2'de uretildigini dogrulayin. ajan1 uzerindeki dosyalara su an dokunmayin (ajan1 hala kullaniliyor).",
  "kurulum": [
   {
    "dosya": {
     "host": "ajan1",
     "yol": "/app/scripts/ozet_hesapla.sh",
     "icerik": "#!/bin/sh\n. /app/scripts/ozet.conf\necho \"ozet $ETIKET $(date +%Y%m%d) sunucu=$(hostname)\" > /data/giden/ozet_hesapla_$(date +%Y%m%d).txt\necho tamam\n",
     "sahip": "batch:batch",
     "mod": "755"
    }
   },
   {
    "dosya": {
     "host": "ajan1",
     "yol": "/app/scripts/ozet.conf",
     "icerik": "ETIKET=aylik\n",
     "sahip": "batch:batch",
     "mod": "644"
    }
   },
   {
    "deploy": {
     "RAPORLAMA": {
      "Type": "Folder",
      "Host": "ajan1",
      "RunAs": "batch",
      "OZET": {
       "Type": "Job:Script",
       "FilePath": "/app/scripts",
       "FileName": "ozet_hesapla.sh"
      }
     }
    }
   }
  ],
  "kontroller": [
   {
    "tanim": {
     "folder": "RAPORLAMA",
     "job": "OZET",
     "alan": {
      "Host": "ajan2",
      "Type": "Job:Script",
      "FileName": "ozet_hesapla.sh"
     }
    }
   },
   {
    "is": {
     "folder": "RAPORLAMA",
     "job": "OZET",
     "durum": "Ended OK"
    }
   },
   {
    "dosya": {
     "host": "ajan2",
     "yol": "/data/giden/ozet_hesapla_{GUN}.txt",
     "icerir": "aylik {GUN} sunucu=ajan2"
