<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- JOC Cockpit veritabani baglantisi: laboratuvar agi icindeki PostgreSQL.
     Hesap yalnizca bu laboratuvara aittir; veritabani disariya port acmaz. -->
<hibernate-configuration>
	<session-factory>
		<property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
		<property name="hibernate.connection.password">js7lab</property>
		<property name="hibernate.connection.url">jdbc:postgresql://js7-db:5432/js7</property>
		<property name="hibernate.connection.username">js7</property>
		<property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
		<property name="hibernate.show_sql">false</property>
		<property name="hibernate.connection.autocommit">false</property>
		<property name="hibernate.format_sql">true</property>
		<property name="hibernate.temp.use_jdbc_metadata_defaults">false</property>
		<!-- Hikari Connection Pool -->
		<property name="hibernate.connection.provider_class">org.hibernate.hikaricp.internal.HikariCPConnectionProvider</property>
		<property name="hibernate.hikari.maximumPoolSize">10</property>
	</session-factory>
</hibernate-configuration>
